<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Convenience group: bundles the rights a user needs to run the whole flow
         (Sales + Inventory + Invoicing). Assign it to the users who will use the button. -->
    <record id="group_sale_quick_flow" model="res.groups">
        <field name="name">Quick Sales Flow (Confirm, Deliver, Invoice, Pay)</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_invoice')),
        ]"/>
    </record>
</odoo>
