<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_quick_payment_wizard_form" model="ir.ui.view">
        <field name="name">sale.quick.payment.wizard.form</field>
        <field name="model">sale.quick.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="move_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="amount_total"/>
                        <field name="amount_residual" class="fw-bold"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="payment_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="amount" readonly="payment_type == 'full'"/>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                        <field name="memo"/>
                    </group>
                </group>
                <footer>
                    <button name="action_register_payment" string="Register Payment"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
