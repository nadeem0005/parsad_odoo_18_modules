<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wh_transfer" model="ir.module.category">
        <field name="name">Warehouse Transfers</field>
        <field name="description">Permission levels for warehouse transfer orders.</field>
        <field name="sequence">35</field>
    </record>

    <!-- The three working roles are independent: none of them includes another. -->
    <record id="group_wh_transfer_user" model="res.groups">
        <field name="name">Creator</field>
        <field name="category_id" ref="module_category_wh_transfer"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Sender side: creates, edits, confirms and cancels transfer orders that start from his warehouses. Cannot ship or receive.</field>
    </record>

    <record id="group_wh_transfer_shipper" model="res.groups">
        <field name="name">Shipper</field>
        <field name="category_id" ref="module_category_wh_transfer"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Only ships confirmed orders that start from his warehouses. Cannot create, confirm or cancel.</field>
    </record>

    <record id="group_wh_transfer_receiver" model="res.groups">
        <field name="name">Receiver</field>
        <field name="category_id" ref="module_category_wh_transfer"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Only receives orders in transit that arrive at his warehouses. Cannot create, confirm, cancel or ship.</field>
    </record>

    <record id="group_wh_transfer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_wh_transfer"/>
        <field name="implied_ids" eval="[
            (4, ref('group_wh_transfer_user')),
            (4, ref('group_wh_transfer_shipper')),
            (4, ref('group_wh_transfer_receiver'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full control on every warehouse, including reset to draft, delete and access to linked pickings.</field>
    </record>
</odoo>
