<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_payment_report_view_pivot" model="ir.ui.view">
        <field name="name">sale.order.payment.report.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Payment Status" sample="1">
                <field name="user_id" type="row"/>
                <field name="inv_payment_status" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="inv_paid_amount" type="measure"/>
                <field name="inv_pending_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_payment_report_view_graph" model="ir.ui.view">
        <field name="name">sale.order.payment.report.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Payment Status" type="bar" sample="1">
                <field name="user_id"/>
                <field name="inv_pending_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sale_payment_report_view_list" model="ir.ui.view">
        <field name="name">sale.order.payment.report.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Payment Status" sample="1" create="0"
                  decoration-danger="inv_payment_status == 'unpaid'"
                  decoration-warning="inv_payment_status == 'partial'">
                <field name="currency_id" column_invisible="True"/>
                <field name="name" string="Order"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="warehouse_id" optional="show"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="inv_paid_amount" sum="Paid" widget="monetary"/>
                <field name="inv_pending_amount" sum="Pending" widget="monetary"/>
                <field name="inv_payment_status" widget="badge"
                       decoration-danger="inv_payment_status == 'unpaid'"
                       decoration-warning="inv_payment_status == 'partial'"
                       decoration-success="inv_payment_status == 'paid'"/>
                <field name="inv_paid_percent" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="sale_payment_report_view_search" model="ir.ui.view">
        <field name="name">sale.order.payment.report.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Payment Status">
                <field name="name" string="Order"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="warehouse_id"/>
                <filter string="Payment Pending" name="payment_pending"
                        domain="[('inv_payment_status', 'in', ('unpaid', 'partial'))]"/>
                <filter string="Not Paid" name="payment_unpaid"
                        domain="[('inv_payment_status', '=', 'unpaid')]"/>
                <filter string="Partially Paid" name="payment_partial"
                        domain="[('inv_payment_status', '=', 'partial')]"/>
                <filter string="Fully Paid" name="payment_paid"
                        domain="[('inv_payment_status', '=', 'paid')]"/>
                <separator/>
                <filter string="Order Date" name="order_date" date="date_order"/>
                <group expand="0" string="Group By">
                    <filter string="Salesperson" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Payment Status" name="group_status" context="{'group_by': 'inv_payment_status'}"/>
                    <filter string="Order Month" name="group_month" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_payment_report_action" model="ir.actions.act_window">
        <field name="name">Payment Status</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sale_payment_report_view_search"/>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="context">{'search_default_payment_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No confirmed order found</p>
            <p>This report shows, for every confirmed sale order, how much was paid and how much is still pending.</p>
        </field>
    </record>

    <record id="sale_payment_report_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="sale_payment_report_view_pivot"/>
        <field name="act_window_id" ref="sale_payment_report_action"/>
    </record>
    <record id="sale_payment_report_action_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="sale_payment_report_view_graph"/>
        <field name="act_window_id" ref="sale_payment_report_action"/>
    </record>
    <record id="sale_payment_report_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale_payment_report_view_list"/>
        <field name="act_window_id" ref="sale_payment_report_action"/>
    </record>

    <menuitem id="menu_sale_payment_report"
              name="Payment Status"
              parent="sale.menu_sale_report"
              action="sale_payment_report_action"
              sequence="20"
              groups="sales_team.group_sale_salesman"/>
</odoo>
