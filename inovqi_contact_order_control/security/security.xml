<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categories - -->
    <record id="module_category_inovqi_contact" model="ir.module.category">
        <field name="name">Inovqi Contacts</field>
        <field name="description">Business role classification of contacts.</field>
        <field name="sequence">60</field>
    </record>
    <record id="module_category_inovqi_pricing" model="ir.module.category">
        <field name="name">Inovqi Order Pricing</field>
        <field name="description">Manual price overrides on Sales and Purchase orders.</field>
        <field name="sequence">61</field>
    </record>

    <!-- Contact role editing (separate from price management) - -->
    <record id="group_contact_role_manager" model="res.groups">
        <field name="name">Contact Role Manager</field>
        <field name="category_id" ref="module_category_inovqi_contact"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">May change the Vendor / Customer / Employee classification of contacts.
Does NOT grant any price override permission.</field>
    </record>

    <!-- Price override groups - -->
    <record id="group_sale_price_manager" model="res.groups">
        <field name="name">Sales Price Manager</field>
        <field name="category_id" ref="module_category_inovqi_pricing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">May manually override unit price / discount on Sales Order lines
and the pricelist of a Sales Order.</field>
    </record>

    <record id="group_purchase_price_manager" model="res.groups">
        <field name="name">Purchase Price Manager</field>
        <field name="category_id" ref="module_category_inovqi_pricing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">May manually override unit price / discount on Purchase Order lines.</field>
    </record>

    <record id="group_order_price_manager" model="res.groups">
        <field name="name">Inovqi Order Price Manager</field>
        <field name="category_id" ref="module_category_inovqi_pricing"/>
        <field name="implied_ids" eval="[(4, ref('group_sale_price_manager')), (4, ref('group_purchase_price_manager'))]"/>
        <field name="comment">Umbrella group: may override prices on BOTH Sales and Purchase orders.
It deliberately grants no other access right.</field>
    </record>

    <!-- Administrator policy -
         Settings administrators may maintain contact roles, but are NOT given
         price override rights implicitly: price power must be granted explicitly.
    -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('inovqi_contact_order_control.group_contact_role_manager'))]"/>
    </record>
</odoo>
