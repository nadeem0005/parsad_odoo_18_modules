<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inovqi_control" model="ir.ui.view">
        <field name="name">sale.order.form.inovqi.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Customers must be classified beforehand: no on-the-fly contact creation here.
                 (The customer domain itself is defined on the model field.) -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{"always_reload": True, "no_create": True, "no_quick_create": True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
