<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inovqi_price_violation_log_view_list" model="ir.ui.view">
        <field name="name">inovqi.price.violation.log.list</field>
        <field name="model">inovqi.price.violation.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="field_name"/>
                <field name="operation"/>
                <field name="requested_value"/>
                <field name="current_value"/>
            </list>
        </field>
    </record>

    <record id="inovqi_price_violation_log_view_form" model="ir.ui.view">
        <field name="name">inovqi.price.violation.log.form</field>
        <field name="model">inovqi.price.violation.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                            <field name="field_name"/>
                            <field name="requested_value"/>
                            <field name="current_value"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="inovqi_price_violation_log_action" model="ir.actions.act_window">
        <field name="name">Blocked Price Changes</field>
        <field name="res_model">inovqi.price.violation.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_inovqi_price_violation_log"
              name="Blocked Price Changes"
              parent="base.menu_administration"
              action="inovqi_price_violation_log_action"
              groups="base.group_system,inovqi_contact_order_control.group_order_price_manager"
              sequence="90"/>
</odoo>
