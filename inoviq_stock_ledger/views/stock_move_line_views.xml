<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inventory > Reporting > Moves History (list) -->
    <record id="view_move_line_tree_inoviq_ledger" model="ir.ui.view">
        <field name="name">stock.move.line.list.inoviq.ledger</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="ledger_warehouse_id" optional="show"/>
                <field name="ledger_opening_qty" optional="show"
                       invisible="state != 'done'"/>
                <field name="ledger_in_qty" optional="show" sum="Total In"
                       invisible="state != 'done'"/>
                <field name="ledger_out_qty" optional="show" sum="Total Out"
                       invisible="state != 'done'"/>
                <field name="ledger_closing_qty" optional="show"
                       invisible="state != 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
