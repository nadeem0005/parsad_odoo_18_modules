<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_stock_tree_inoviq_branch" model="ir.ui.view">
        <field name="name">product.product.stock.list.inoviq.branch</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@icon='fa-pencil']" position="attributes">
                <attribute name="invisible">context.get('inoviq_branch_user')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
